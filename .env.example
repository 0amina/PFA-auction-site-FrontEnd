# Copy to .env and adjust if your gateway runs elsewhere.
#
# The frontend speaks to a SINGLE backend entry point — the API Gateway —
# which proxies all microservices (user, auction, bidding, payment,
# blockchain, notification, messaging). Do NOT point this at an individual
# service port; use the gateway (default 3000).
VITE_API_URL=http://localhost:3000

# Real-time WebSocket endpoints (connect directly to the services, not the gateway).
VITE_NOTIFICATIONS_WS_URL=http://localhost:3005
VITE_MESSAGING_WS_URL=http://localhost:3007
