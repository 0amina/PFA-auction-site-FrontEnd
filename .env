# Frontend → backend API base URL.
# The browser talks ONLY to the API Gateway, which proxies every microservice.
VITE_API_URL=http://localhost:3000

# Real-time WebSocket endpoints. These connect DIRECTLY to the services (the HTTP
# gateway does not proxy WebSockets); auth is via the JWT in the socket handshake.
VITE_NOTIFICATIONS_WS_URL=http://localhost:3005
VITE_MESSAGING_WS_URL=http://localhost:3007
